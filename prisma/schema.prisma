// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modelo para las estadísticas de los gráficos
model Metric {
  id              Int      @id @default(autoincrement())
  sede            String   // "BARRANQUILLA" o "PUERTO_COLOMBIA"
  mes             String   // "Enero", "Febrero", "Marzo", "Abril"
  year            Int      // Año de la métrica
  aprovechamiento Float    // Toneladas de aprovechamiento
  rechazo         Float    // Toneladas de rechazo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Evita que se duplique el mismo mes para una misma sede
  @@unique([sede, mes, year])
}

model Admin {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  password        String    
  email           String    // El correo donde llegará el código (ej: el de Don Luis o el tuyo)
  twoFactorCode   String?   // Para guardar el código temporal de 6 dígitos
  twoFactorExpires DateTime? // Para controlar que expire en 5 minutos
}

model Lead {
  id           Int      @id @default(autoincrement())
  nombre       String
  telefono     String
  email        String
  empresa      String?  // Opcional
  direccion    String?  // Opcional
  servicio     String
  especialidad String?  // Opcional
  mensaje      String?  // Opcional
  createdAt    DateTime @default(now()) // Fecha de registro
}

model EmpresasClientes {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String         @unique @db.VarChar(150)
  correo        String         @db.VarChar(100)
  fechaCreacion DateTime       @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  certificados  Certificados[]

  @@map("empresas_clientes")
}

model Certificados {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String           @map("empresa_id") @db.Uuid
  tipo          String           @db.VarChar(20) // 'PODA' o 'RESIDUOS'
  nombreArchivo String           @map("nombre_archivo") @db.VarChar(255) // Guarda el nombre original del archivo enviado
  fechaEnvio    DateTime         @default(now()) @map("fecha_envio") @db.Timestamp(6)
  empresa       EmpresasClientes @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@map("certificados")
}