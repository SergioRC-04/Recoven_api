// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Modelo para las estadísticas de los gráficos
model Metric {
  id              Int      @id @default(autoincrement())
  sede            String   // "BARRANQUILLA" o "PUERTO_COLOMBIA"
  mes             String   // "Enero", "Febrero", "Marzo", "Abril"
  year            Int      // Año de la métrica
  aprovechamiento Float    // Toneladas de aprovechamiento
  rechazo         Float    // Toneladas de rechazo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Evita que se duplique el mismo mes para una misma sede
  @@unique([sede, mes, year])
}

model Admin {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  password        String    
  email           String    // El correo donde llegará el código (ej: el de Don Luis o el tuyo)
  twoFactorCode   String?   // Para guardar el código temporal de 6 dígitos
  twoFactorExpires DateTime? // Para controlar que expire en 5 minutos
}

model Lead {
  id           Int      @id @default(autoincrement())
  nombre       String
  telefono     String
  email        String
  empresa      String?  // Opcional
  direccion    String?  // Opcional
  servicio     String
  especialidad String?  // Opcional
  mensaje      String?  // Opcional
  createdAt    DateTime @default(now()) // Fecha de registro
}