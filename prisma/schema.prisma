// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Modelo para las estadísticas de los gráficos
model Metric {
  id              Int      @id @default(autoincrement())
  sede            String   // "BARRANQUILLA" o "PUERTO_COLOMBIA"
  mes             String   // "Enero", "Febrero", "Marzo", "Abril"
  aprovechamiento Float    // Toneladas de aprovechamiento
  rechazo         Float    // Toneladas de rechazo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Evita que se duplique el mismo mes para una misma sede
  @@unique([sede, mes])
}

// Modelo básico para el Administrador que mencionas para el futuro Login
model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String // Almacenada con hash (bcrypt) más adelante
}