generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// Modelo para las estadísticas de los gráficos
model Metric {
  id              Int      @id @default(autoincrement())
  sede            String // "BARRANQUILLA" o "PUERTO_COLOMBIA"
  mes             String // "Enero", "Febrero", "Marzo", "Abril"
  year            Int // Año de la métrica
  aprovechamiento Float // Toneladas de aprovechamiento
  rechazo         Float // Toneladas de rechazo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Evita que se duplique el mismo mes para una misma sede
  @@unique([sede, mes, year])
}

model Admin {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  password         String
  email            String // El correo donde llegará el código (ej: el de Don Luis o el tuyo)
  twoFactorCode    String? // Para guardar el código temporal de 6 dígitos
  twoFactorExpires DateTime? // Para controlar que expire en 5 minutos
}

model Lead {
  id           Int      @id @default(autoincrement())
  nombre       String
  telefono     String
  email        String
  empresa      String? // Opcional
  direccion    String? // Opcional
  servicio     String
  especialidad String? // Opcional
  mensaje      String? // Opcional
  createdAt    DateTime @default(now()) // Fecha de registro
}

model EmpresasClientes {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String         @unique @db.VarChar(150)
  correo        String         @db.VarChar(100)
  fechaCreacion DateTime       @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  certificados  Certificados[]

  @@map("empresas_clientes")
}

enum EstadoCertificado {
  PENDIENTE
  ENVIADO
  FALLIDO
}

model Certificados {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String            @map("empresa_id") @db.Uuid
  tipo          String            @db.VarChar(20)
  nombreArchivo String            @map("nombre_archivo") @db.VarChar(255)
  urlArchivo    String?           @map("url_archivo") @db.VarChar(255)
  estado        EstadoCertificado @default(PENDIENTE)
  errorDetalle  String?           @map("error_detalle")
  fechaEnvio    DateTime          @default(now()) @map("fecha_envio") @db.Timestamp(6)

  empresa EmpresasClientes @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@map("certificados")
}

enum TipoPqrsdf {
  PETICION
  QUEJA
  RECLAMO
  SUGERENCIA
  DENUNCIA
  FELICITACION
}

enum EstadoPqrsdf {
  RECIBIDO
  EN_TRAMITE
  RESUELTO
  RECHAZADO
}

model Pqrsdf {
  id                    String        @id @default(uuid())
  radicado              String        @unique // Ejemplo: PQRS-202607-A1B2
  tipo                  TipoPqrsdf
  estado                EstadoPqrsdf  @default(RECIBIDO)
  
  // Datos del Peticionario
  nombreCompleto        String
  tipoIdentificacion    String        // CC, NIT, CE, Pasaporte
  numeroIdentificacion  String
  email                 String
  telefono              String?
  direccion             String?
  
  // Detalle de la solicitud
  asunto                String
  descripcion           String
  urlArchivo            String?       // Documento adjunto cargado a Supabase
  
  // Respuesta o Seguimiento Interno
  respuesta             String?
  urlRespuesta          String?
  fechaRespuesta        DateTime?
  
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([radicado])
  @@index([numeroIdentificacion])
  @@map("pqrsdf")
}

model Localidades {
  id            String                                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectId      Int                                         @map("object_id")
  nombre        String                                      @db.VarChar(100)
  identificador String                                      @unique @db.VarChar(10)
  areaShape     Float?                                      @map("st_area_shape")
  geom          Unsupported("geometry(MultiPolygon, 9377)")?
  barrios       Barrios[]

  @@index([geom], type: Gist, map: "localidades_geom_idx")
  @@map("localidades")
}

model Barrios {
  id            String                                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectId      Int                                         @map("object_id")
  identificador String                                      @unique @db.VarChar(20) // Agregado @unique para soportar la relación
  nombre        String                                      @map("nombre_barrio") @db.VarChar(150)
  nombrePieza   Int?                                        @map("nombre_pieza")
  localidadCod  String                                      @map("localidad_cod") @db.VarChar(10)
  observaciones String?                                     @db.VarChar(100)
  areaShape     Float?                                      @map("st_area_shape")
  geom          Unsupported("geometry(MultiPolygon, 9377)")?

  localidadRel Localidades?        @relation(fields: [localidadCod], references: [identificador])
  recyclers    RecyclerBarrio[] // Relación opuesta agregada
  microrrutas  MicrorrutaBarrio[] // Relación opuesta con microrrutas

  @@index([geom], type: Gist, map: "barrios_geom_idx")
  @@map("barrios")
}

model Vias {
  id       String                                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectId Int                                            @map("object_id")
  texto    String?                                        @db.VarChar(100)
  abrTexto String?                                        @map("abr_texto") @db.VarChar(50)
  shapeLen Float?                                         @map("shape_len")
  geom     Unsupported("geometry(MultiLineString, 9377)")?

  @@index([geom], type: Gist, map: "vias_geom_idx")
  @@map("vias")
}

enum EstadoVinculacion {
  ACTIVO
  INACTIVO
}

enum ClasificacionRecycler {
  NUEVO
  REGULAR
  A_QUITAR
}

enum EstadoMicrorruta {
  BORRADOR
  COMPLETO
}

model Recycler {
  id                 Int                   @id @default(autoincrement())
  cedula             String                @unique
  nombreCompleto     String
  censado            Boolean               @default(false)
  estadoVinculacion  EstadoVinculacion     @default(ACTIVO)
  clasificacion      ClasificacionRecycler @default(NUEVO)
  deletedAt          DateTime?             @map("deleted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  fechaIngreso    DateTime         @default(dbgenerated("'2026-01-01'::timestamp")) @map("fecha_ingreso")

  // Relaciones
  microrrutas RecyclerMicrorruta[]
  barrios     RecyclerBarrio[]

  @@map("recyclers")
}

model Microrruta {
  id                    Int              @id @default(autoincrement())
  nombre                String           @unique
  tipo                  Int              // 1 a 8 según SUI
  fechaOperacion        DateTime?        @map("fecha_operacion")
  dirInicio             String?          @map("dir_inicio")
  horaInicio            String?          @map("hora_inicio")
  dirFin                String?          @map("dir_fin")
  horaFin               String?          @map("hora_fin")
  distPavimentada       Float?           @default(0) @map("dist_pavimentada")
  distNoPavimentada     Float?           @default(0) @map("dist_no_pavimentada")
  frecuencia            Int?             
  diasFrecuencia        String?          @map("dias_frecuencia")
  estacionTransferencia Int?             @map("estacion_transferencia")
  tipoBarrido           Int?             @map("tipo_barrido")
  estado                EstadoMicrorruta @default(BORRADOR)

  // Geometría PostGIS guardada en EPSG:9377
  geom Unsupported("geometry(LineString, 9377)")?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recyclers RecyclerMicrorruta[]
  barrios   MicrorrutaBarrio[]

  @@map("microrrutas")
}

model RecyclerMicrorruta {
  recyclerId   Int        @map("recycler_id")
  microrrutaId Int        @map("microrruta_id")
  recycler     Recycler   @relation(fields: [recyclerId], references: [id], onDelete: Cascade)
  microrruta   Microrruta @relation(fields: [microrrutaId], references: [id], onDelete: Cascade)

  @@id([recyclerId, microrrutaId])
  @@map("recycler_microrruta")
}

model RecyclerBarrio {
  recyclerId Int      @map("recycler_id")
  barrioId   String   @map("barrio_id")
  recycler   Recycler @relation(fields: [recyclerId], references: [id], onDelete: Cascade)
  barrio     Barrios  @relation(fields: [barrioId], references: [identificador], onDelete: Cascade) // Relación agregada

  @@id([recyclerId, barrioId])
  @@map("recycler_barrio")
}

// Barrio(s) por los que efectivamente transcurre una microrruta, calculado
// geométricamente (ver microrrutas-barrios.util.ts) al crear la ruta o al
// redibujar su trazo — no se edita a mano. Una ruta puede tener varios
// barrios si cruza de uno a otro; el criterio de "cruzó de verdad" vs.
// "solo tocó el borde compartido" es lo que decide ese cálculo, no esta
// tabla en sí, que solo guarda el resultado ya decidido.
model MicrorrutaBarrio {
  microrrutaId Int        @map("microrruta_id")
  barrioId     String     @map("barrio_id")
  microrruta   Microrruta @relation(fields: [microrrutaId], references: [id], onDelete: Cascade)
  barrio       Barrios    @relation(fields: [barrioId], references: [identificador], onDelete: Cascade)

  @@id([microrrutaId, barrioId])
  @@map("microrruta_barrio")
}